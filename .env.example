# Dashboard API (Vite only exposes variables prefixed with VITE_)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Example administrator/integration key. Generate a new random value for each real environment.
FARM_ADMIN_KEY=replace-with-a-random-secret

# Optional SMTP configuration for email notifications. These are placeholders, not real credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_SSL=true
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_TO=farm-admin@example.com
